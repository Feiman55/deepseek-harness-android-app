# 引擎 HOME（payload/dshhome）里的 npm 默认参数 —— 由构建期从 config/mirrors.env 生成/复制。
#
# 为什么放这里：引擎进程的 HOME = payload/dshhome，npm/pnpm 会读这个文件；
#   插件管理（plugin_manager 内部走 pnpm）、自开发时的 npm/pip 都受它影响。
#
# 三项各自的理由：
#   registry                —— 国内直连 registry.npmjs.org 常失败；有 lock integrity 兜底，换源安全
#   package-import-method   —— /sdcard 与 app 私有目录都不能建符号链接（实测），hardlink 会失败
#   audit/fund              —— 关掉与构建无关的网络往返与噪音
registry=https://registry.npmmirror.com
package-import-method=copy
audit=false
fund=false
update-notifier=false

# 本版：pnpm 在 /sdcard（FUSE）上建不了符号链接 → 用 npm 式平铺布局（不建软链）。
# 注意：依赖目录仍应放在**应用私有目录**（$HOME / $DSH_HOME 下），/sdcard 只适合放源码。
node-linker=hoisted
