# ============================================================================
# 镜像与取文件顺序 —— **单一真源**
#
# 谁读它：
#   · 构建期：tools/fetch-kernel.sh（npm registry）、tools/fetch-runtime.sh（GitHub Release 代理链）
#   · 设备期：payload 里的 bin/mirror-get（取仓库文件顺序），构建时本文件会被复制成 payload/bin/mirrors.env
#
# 怎么改：只改这里一处，构建期与设备期同时生效。改完记得跑一次构建（文件会随 payload 更新）。
#
# ⚠ 能安全换源的前提是**有校验**：
#     · npm 有 lock 里的 integrity（逐包 sha512）→ 换 registry 安全；
#     · 运行时资产有 sha256 pin（RUNTIME_SHA256_DEFAULT）→ 换代理安全；
#     · `git clone`（无校验）与 pip（无哈希）**不做静默换源**，只给建议、由人显式决定。
# ============================================================================

# ── npm registry：内核树冻结安装（有 lock integrity 兜底）────────────────────
# 实测（2026-10-14）：npmmirror 与我们 lock 里 12/12 抽样 integrity 一致；
# `npm ci --registry=<npmmirror>` 21 秒装出 667 包 / 25,849 文件 / 222.4 MB，与官方逐项相同。
NPM_REGISTRY_PRIMARY="https://registry.npmmirror.com"
NPM_REGISTRY_FALLBACK="https://registry.npmjs.org"

# ── PyPI：设备侧 pip（预装包 / 自开发时需要）─────────────────────────────────
PIP_INDEX_PRIMARY="https://pypi.tuna.tsinghua.edu.cn/simple"
PIP_INDEX_FALLBACK="https://pypi.org/simple"
PIP_TRUSTED_HOST_PRIMARY="pypi.tuna.tsinghua.edu.cn"

# ── GitHub Release 资产（运行时资产）：官方优先，代理兜底 ─────────────────────
# 顺序 = 尝试顺序；每路都必须通过 sha256 校验才算成功。
GH_RELEASE_PROXIES="https://ghfast.top/ https://gh-proxy.com/"

# ── 仓库文件（raw）：设备侧取文件顺序 ────────────────────────────────────────
# 占位符用 @REPO@ / @REF@ / @PATH@ —— **故意不用 ${...}**：这份文件会被 shell source，
# 而 `${PATH}` 会被展开成环境变量 PATH（实测踩过：URL 直接变成宿主 PATH 的碎片）。
RAW_URL_TEMPLATES="https://cdn.jsdelivr.net/gh/@REPO@@@REF@/@PATH@ https://ghfast.top/https://raw.githubusercontent.com/@REPO@/@REF@/@PATH@ https://gh-proxy.com/https://raw.githubusercontent.com/@REPO@/@REF@/@PATH@ https://raw.githubusercontent.com/@REPO@/@REF@/@PATH@"
# GitHub API contents（base64，jsdelivr 也不可达时的兜底；占用 API 配额）
GH_API_CONTENTS="https://api.github.com/repos/@REPO@/contents/@PATH@?ref=@REF@"

# ── 设备端 npm/pnpm 默认参数 ────────────────────────────────────────────────
# /sdcard 不能建符号链接（pnpm 默认 hardlink 会失败）→ 用 copy 导入；
# 引擎 HOME 里的 .npmrc 会带上这些（见 android-app/payload-extra/dshhome/.npmrc）。
NPM_PACKAGE_IMPORT_METHOD="copy"
